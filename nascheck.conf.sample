# nascheck configuration.
#
# Copy to nascheck.conf in the same directory and edit. Without that file
# nascheck uses the values below, which are its built-in defaults.
#
# A limit is "warning [critical]": a value at or above it raises that
# level. "-" means no limit; a single value leaves the critical level off.
# Durations take a suffix: s, m, h or d.

# --- Daemon ---------------------------------------------------------------
# Changes here need "service nascheck restart"; the rules below only
# "service nascheck reload".

# Where the daemon keeps its data, and the socket for "nascheck refresh".
# Defaults: /var/db/nascheck/nascheck.db on FreeBSD,
# /var/lib/nascheck/nascheck.db on Linux.
#database		/var/db/nascheck/nascheck.db
#socket			/var/run/nascheck.sock

# Members of this group can read the database and ask for a refresh,
# without root. Unset: only root's group (wheel on FreeBSD).
#group			operator

smart_interval		1d	# full SMART report of every disk
temp_interval		5m	# temperature samples, for the graphs
standby_retry		1h	# a disk in standby is tried again after this
wake_after		7d	# then woken up if its report is older
temp_keep		90d	# temperature samples older than this are deleted

# --- Rules ----------------------------------------------------------------

# Temperature in Celsius. "auto" uses the limits the disk reports itself
# (NVMe: warning and critical composite temperature).
temp_hdd		45 55
temp_ssd		60 70
temp_nvme		auto

# Power-on hours since the last SMART self-test, short or extended.
# 720 is a month for a disk that never sleeps; "-" disables the check.
selftest_max_age	720

# NVMe wear estimate (percentage_used, may exceed 100) and media errors.
nvme_used		80 100
nvme_media_errors	1 -

# ATA attributes: id, then limits on the raw value. The first ata_attr
# line replaces this whole list.
ata_attr 5   1 -	# Reallocated_Sector_Ct
ata_attr 187 1 -	# Reported_Uncorrect
ata_attr 197 1 -	# Current_Pending_Sector
ata_attr 198 1 -	# Offline_Uncorrectable
# ata_attr 188 1 -	# Command_Timeout: vendor specific, noisy on Seagate
